rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }
    function isPatientOwner(patientId) {
      return signedIn() && request.auth.uid == patientId;
    }

    // Deny-by-default. The API is the only writer; direct SDK access is not a
    // supported path in the submission.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}