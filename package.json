    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "otplib": "^13.6.0",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.7",
