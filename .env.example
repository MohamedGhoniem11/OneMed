# =============================================================================
# OneMed backend — environment template
# Copy to `.env` and adjust. With NO changes, the API boots in local demo mode
# (file-backed persistence + local password auth) and needs no cloud credentials.
# =============================================================================

# --- runtime -----------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Behind a reverse proxy (nginx, Cloud Run, etc.) set this to the number of
# trusted proxy hops, e.g. 1. Leave empty for direct connections.
TRUST_PROXY=

# --- persistence & auth provider --------------------------------------------
# local      = file-backed store in LOCAL_DATA_DIR (offline demo/CI)
# firestore  = Firebase Firestore (requires credentials below)
# Leave blank to auto-select: firestore when credentials are configured,
# otherwise local.
PERSISTENCE=

# local      = backend-issued JWT + scrypt password hashes (offline demo/CI)
# firebase   = Firebase Authentication (requires credentials below)
# Leave blank to auto-select: firebase when credentials are configured,
# otherwise local.
AUTH_PROVIDER=

# Directory for the local store and the generated development JWT secret.
LOCAL_DATA_DIR=data

# --- local auth (demo/CI) ----------------------------------------------------
# 32+ random characters. REQUIRED in production (signs OneMed 15-minute access
# tokens after the IdP authenticates). In development a secret is generated once
# at data/.jwt-secret if omitted.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=onemed-api
AUTH_JWT_AUDIENCE=onemed-clients
AUTH_ACCESS_TTL_SECONDS=900

# Server-side session layer (R3/R65). Refresh tokens rotate on every use and
# live in an httpOnly cookie. Inactivity timeouts differ for patients vs staff.
AUTH_REFRESH_TTL_DAYS=7
AUTH_IDLE_MINUTES_PATIENT=30
AUTH_IDLE_MINUTES_STAFF=15
AUTH_MFA_TOKEN_TTL_SECONDS=300

# --- registration OTP / MFA --------------------------------------------------
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
# Demo delivery returns the code in the API response and logs it. It defaults
# to true only for local demo/CI. Production fails at startup if this is true:
# real delivery uses Firebase phone Auth (see FIREBASE_PHONE_AUTH below).
AUTH_OTP_DEV_DELIVERY=true

# Refresh-token cookie (httpOnly). SameSite=strict|lax|none; none requires
# secure=true. Set AUTH_COOKIE_DOMAIN when the API and frontend share a parent
# domain and the cookie must cross subdomains.
AUTH_COOKIE_NAME=onemed_rt
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# --- Firebase (production mode) ---------------------------------------------
# Option A: path to a service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Option B: paste the service account JSON as a single-line env var (hosting).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Required only for backend password sign-in / custom-token exchange in
# Firebase mode. It is the *Web API key* (Project settings → General), not the
# service account key. Without it, the API returns a customToken that the
# client SDK must exchange itself.
FIREBASE_API_KEY=
# Firebase phone Auth for registration/login OTP. Required in production.
FIREBASE_PHONE_AUTH=true

# Firebase Storage (encrypted original uploads) and Cloud Functions (LLM/RAG).
FIREBASE_STORAGE_BUCKET=
STORAGE_DRIVER=local
LLM_DRIVER=direct
FUNCTIONS_BASE_URL=

# Backups and record archival (EDP retention).
BACKUP_DIR=data/backups
ARCHIVE_AFTER_DAYS=365

# Emulator support (optional; Java required). When set, the Admin SDK talks to
# the local emulator instead of the cloud project.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# --- Gemini (LLM features: first-aid chatbot + prescription extraction) ------
# Google AI Studio key. Never commit the real value; this template is blank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- HTTP security -----------------------------------------------------------
# Comma-separated allowlist. Use * only for throwaway local experiments.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Public origin embedded in QR codes and NFC handoff pages.
PUBLIC_BASE_URL=http://localhost:5173
# Doctor-patient connection QR lifetime (15 minutes per the project document).
CONNECTION_TTL_SECONDS=900
# Public emergency page / chatbot requests per window (abuse protection).
EMERGENCY_RATE_LIMIT_MAX=60
# Prescription fulfillment link lifetime (24 hours per the project document).
FULFILLMENT_TTL_SECONDS=86400
NFC_TTL_SECONDS=31536000
EMERGENCY_TTL_SECONDS=31536000

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
OCR_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_MAX=30
RATE_LIMIT_DISABLED=

JSON_BODY_LIMIT=1mb

# --- Medical ingestion / OCR -------------------------------------------------
TESSERACT_LANG=ara+eng
# TESSERACT_CACHE_PATH=
# OCR_DEBUG=
# Below 80% confidence, extractions are stored as needs_review and are not
# exposed to patients until a staff member confirms them (OQ4).
OCR_CONFIDENCE_THRESHOLD=80
# Maximum accepted medical upload size (PDF, images, CSV/JSON, FHIR, DICOM).
UPLOAD_MAX_MB=50
# Where encrypted original documents are written (gitignored in demo mode).
UPLOAD_DIR=data/uploads
# REQUIRED in production. 64 hex characters = 32 bytes for AES-256-GCM.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development a key is generated once at data/.upload-key if omitted.
UPLOAD_ENCRYPTION_KEY=
