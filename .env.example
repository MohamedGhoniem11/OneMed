# =============================================================================
# OneMed backend — environment template
# Copy to `.env` and adjust. With NO changes, the API boots in local demo mode
# (file-backed persistence + local password auth) and needs no cloud credentials.
# =============================================================================

# --- runtime -----------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Behind a reverse proxy (nginx, Cloud Run, etc.) set this to the number of
# trusted proxy hops, e.g. 1. Leave empty for direct connections.
TRUST_PROXY=

# --- persistence & auth provider --------------------------------------------
# local      = file-backed store in LOCAL_DATA_DIR (offline demo/CI)
# firestore  = Firebase Firestore (requires credentials below)
# Leave blank to auto-select: firestore when credentials are configured,
# otherwise local.
PERSISTENCE=

# local      = backend-issued JWT + scrypt password hashes (offline demo/CI)
# firebase   = Firebase Authentication (requires credentials below)
# Leave blank to auto-select: firebase when credentials are configured,
# otherwise local.
AUTH_PROVIDER=

# Directory for the local store and the generated development JWT secret.
LOCAL_DATA_DIR=data

# --- local auth (demo/CI) ----------------------------------------------------
# 32+ random characters. REQUIRED when NODE_ENV=production and AUTH_PROVIDER=local.
# In development a secret is generated once at data/.jwt-secret if omitted.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=onemed-api
AUTH_JWT_AUDIENCE=onemed-clients
AUTH_ACCESS_TTL_SECONDS=900

# --- Firebase (production mode) ---------------------------------------------
# Option A: path to a service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Option B: paste the service account JSON as a single-line env var (hosting).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Required only for backend password sign-in / custom-token exchange in
# Firebase mode. It is the *Web API key* (Project settings → General), not the
# service account key. Without it, the API returns a customToken that the
# client SDK must exchange itself.
FIREBASE_API_KEY=

# Emulator support (optional; Java required). When set, the Admin SDK talks to
# the local emulator instead of the cloud project.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# --- HTTP security -----------------------------------------------------------
# Comma-separated allowlist. Use * only for throwaway local experiments.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
OCR_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_MAX=30
RATE_LIMIT_DISABLED=

JSON_BODY_LIMIT=1mb

# --- OCR ---------------------------------------------------------------------
TESSERACT_LANG=ara+eng
# TESSERACT_CACHE_PATH=
# OCR_DEBUG=
